NODE_ENV=production
HOST=127.0.0.1
PORT=3000
PUBLIC_SITE_ORIGIN=https://www.seabyss.com
PLAYFAB_TITLE_ID=replace_with_playfab_title_id
PLAYFAB_SECRET_KEY=xxxxx
XSOLLA_WEBHOOK_SECRET=replace_with_xsolla_webhook_secret
XSOLLA_PROJECT_ID=310966
XSOLLA_PREMIUM_PLAN_ID=321178
XSOLLA_PREMIUM_PLAN_EXTERNAL_ID=NZSorpSt
XSOLLA_ALLOW_SANDBOX_GRANTS=false
XSOLLA_SANDBOX_TEST_PLAYFAB_IDS=
XSOLLA_ALLOW_STARTER_SANDBOX_GRANTS=false
XSOLLA_STARTER_SANDBOX_TEST_PLAYFAB_IDS=
XSOLLA_ALLOW_STARTER_PRODUCTION_GRANTS=false
XSOLLA_ALLOW_DIAMOND_PRODUCTION_GRANTS=false
XSOLLA_ENABLE_STANDALONE_PREMIUM_PRODUCTS=false
PURCHASES_GLOBAL_ENABLED=false
PURCHASES_DIAMOND_ENABLED=false
PURCHASES_STARTER_ENABLED=false
PURCHASES_PREMIUM_ENABLED=false
PURCHASES_DOUBLER_ENABLED=false
XSOLLA_HARDENED_CATALOG_ENABLED=false
XSOLLA_CHECKOUT_MODE=sandbox
XSOLLA_CHECKOUT_SANDBOX_ENABLED=false
XSOLLA_CHECKOUT_PRODUCTION_ENABLED=false
XSOLLA_CHECKOUT_ALLOWED_SKUS=
XSOLLA_API_KEY=
PLAYFAB_FINANCIAL_PROFILE_ENABLED=false
PLAYFAB_FINANCIAL_AUTHORITY_CUTOVER_ENABLED=false
# Progressive gameplay authority is independently gated per domain. The safe
# checked-in/default state is Legacy with empty canary allowlists and all write
# gates disabled. Do not enable several domains for a first canary.
FINANCIAL_DIAMONDS_MODE=Legacy
FINANCIAL_DIAMONDS_CANARY_ENABLED=false
FINANCIAL_DIAMONDS_CUTOVER_ENABLED=false
FINANCIAL_DIAMONDS_MIGRATION_ENABLED=false
FINANCIAL_DIAMONDS_CANARY_PLAYFAB_IDS=
# Read only when FINANCIAL_DIAMONDS_MODE is non-Legacy. The certificate is
# non-secret; the game-server token must remain in the host secret store/env.
FINANCIAL_DIAMONDS_READINESS_CERTIFICATE_PATH=
FINANCIAL_DIAMONDS_TARGET_REDIS_PREFIX=seabyss:financial:diamonds:target:v1:
FINANCIAL_DIAMONDS_GAME_SERVER_ID=
FINANCIAL_DIAMONDS_GAME_SERVER_TOKEN=
FINANCIAL_ELITE_MODE=Legacy
FINANCIAL_ELITE_CANARY_ENABLED=false
FINANCIAL_ELITE_CUTOVER_ENABLED=false
FINANCIAL_ELITE_MIGRATION_ENABLED=false
FINANCIAL_ELITE_CANARY_PLAYFAB_IDS=
FINANCIAL_PREMIUM_MODE=Legacy
FINANCIAL_PREMIUM_CANARY_ENABLED=false
FINANCIAL_PREMIUM_CUTOVER_ENABLED=false
FINANCIAL_PREMIUM_MIGRATION_ENABLED=false
FINANCIAL_PREMIUM_CANARY_PLAYFAB_IDS=
PLAYFAB_ECONOMY_V2_ENABLED=false
PLAYFAB_FINANCIAL_AUTHORITY_V2_ENABLED=false
PLAYFAB_ECONOMY_V2_CATALOG_MAPPINGS_JSON={}
PLAYFAB_ECONOMY_V2_COLLECTION_ID=default
UNITY_FINANCIAL_AUTHORITY_VERSION=legacy_profile_v1
PLAYFAB_FINANCIAL_MIGRATION_VERSION=none
PLAYFAB_FINANCIAL_REVISION_CAS_ENABLED=false
PLAYFAB_FINANCIAL_SERVER_OWNED_FIELDS_ENABLED=false
PLAYFAB_FINANCIAL_REFRESH_ENABLED=false
# Exact PFRN covered by the published global deny policy (must end /Profile/SeabyssFinancialAuthorityV2 or /Profile/*).
PLAYFAB_FINANCIAL_AUTHORITY_POLICY_RESOURCE=
PAYMENT_WORKER_ENABLED=false
PAYMENT_WORKER_POLL_INTERVAL_MS=5000
PAYMENT_WORKER_BATCH_SIZE=8
PAYMENT_WORKER_MAXIMUM_RETRIES=12
PAYMENT_WORKER_BACKOFF_BASE_MS=1000
PAYMENT_WORKER_BACKOFF_MAXIMUM_MS=1800000
PAYMENT_WORKER_LEASE_TTL_MS=30000
PAYMENT_WORKER_LEASE_RENEW_MS=10000
PAYMENT_WORKER_CAS_ATTEMPTS=5
PAYMENT_FINANCIAL_PROFILE_MAX_BYTES=65536
PAYMENT_FINANCIAL_OPERATION_HISTORY_LIMIT=1024
FINANCIAL_SHADOW_MODE_ENABLED=false
FINANCIAL_SHADOW_ENVIRONMENT=sandbox
FINANCIAL_SHADOW_ALLOWED_PLAYFAB_IDS=
FINANCIAL_SHADOW_SERVER_ID=
FINANCIAL_SHADOW_PRESENCE_LEASE_TTL_MS=15000
FINANCIAL_SHADOW_AUTH_CACHE_TTL_MS=5000
FINANCIAL_SHADOW_AUTH_CACHE_MAXIMUM_ENTRIES=2000
FINANCIAL_SHADOW_PER_TICKET_RATE_LIMIT=600
FINANCIAL_SHADOW_GLOBAL_RATE_LIMIT=30000
FINANCIAL_SHADOW_POC_MIRROR_POLL_INTERVAL_MS=2000
FINANCIAL_SHADOW_MAXIMUM_CAS_ATTEMPTS=12
FINANCIAL_SHADOW_MAXIMUM_HISTORY_ENTRIES=2000
UPSTREAM_TIMEOUT_MS=8000
SESSION_SECRET=change_me_long_random_secret
SEABYSS_ENV=beta
REDIS_URL=redis://127.0.0.1:6379
SESSION_TTL_SECONDS=86400
